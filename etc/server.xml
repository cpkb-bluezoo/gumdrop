<!--
  Stock server.xml for the gumdrop servlet container distribution
  (GUMDROP_HOME/conf/server.xml). Read by
  org.bluezoo.gumdrop.servlet.container.ServerXmlLoader; see that class's
  javadoc for the full element/attribute reference.

  Paths here are relative to this file's directory (conf/) and match the
  layout produced by the 'assemble-container' Ant target: webapps/ROOT is
  the extracted root webapp, webapps/manager.war is deployed straight from
  the war with no extraction needed.

  For local HTTPS + HTTP/3 smoke tests see etc/server-tls.xml, scripts/dev-tls-setup.*,
  and BUILDING.md. Production/container notes: docs/CONTAINER-DEPLOYMENT.md.
-->
<server>
  <!-- realm-servlet.xml defines the admin/editor accounts used by both the
       root webapp (realm-name "myRealm") and the manager webapp
       (realm-name "Gumdrop Manager"); both names are aliases for the one
       realm below. -->
  <realm name="myRealm,Gumdrop Manager" class="org.bluezoo.gumdrop.auth.BasicRealm"
         href="realm-servlet.xml"/>

  <context path="" root="../webapps/ROOT" distributable="true"/>
  <context path="/manager" root="../webapps/manager.war"/>

  <listener port="8080"/>
</server>
