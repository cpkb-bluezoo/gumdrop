#!/bin/sh
#
# Gumdrop launcher (POSIX sh: Linux, macOS, BSD).
#
# Requires Java 25+. Prefers the lib/ distribution (GUMDROP_HOME/bin/gumdrop.sh);
# falls back to the legacy fat jar.
#
# Environment: JAVA, GUMDROP_HOME, GUMDROP_JAR, LOGGING_PROPERTIES, JAVA_OPTS,
# MAX_RAM_PERCENTAGE (default 75.0).

set -e

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

if [ -z "${GUMDROP_HOME:-}" ]; then
	if [ -f "$script_dir/dist/container-home/bin/gumdrop.sh" ]; then
		GUMDROP_HOME=$script_dir/dist/container-home
	elif [ -f "$script_dir/bin/gumdrop.sh" ]; then
		GUMDROP_HOME=$script_dir
	fi
	export GUMDROP_HOME
fi

if [ -n "${GUMDROP_HOME:-}" ] && [ -f "$GUMDROP_HOME/bin/gumdrop.sh" ]; then
	gumdrop_bin=$GUMDROP_HOME/bin/gumdrop.sh
	if [ -x "$gumdrop_bin" ]; then
		exec "$gumdrop_bin" "$@"
	fi
	exec sh "$gumdrop_bin" "$@"
fi

java=${JAVA:-java}
GUMDROP_JAR=${GUMDROP_JAR:-$script_dir/dist/gumdrop-container.jar}
LOGGING_PROPERTIES=${LOGGING_PROPERTIES:-$script_dir/logging.properties}
MAX_RAM_PERCENTAGE=${MAX_RAM_PERCENTAGE:-75.0}

logging=
if [ -n "$LOGGING_PROPERTIES" ] && [ -f "$LOGGING_PROPERTIES" ]; then
	logging="-Djava.util.logging.config.file=$LOGGING_PROPERTIES"
fi

# Java 25+: container memory limits are honored without +UseContainerSupport.
jvm_opts="-XX:MaxRAMPercentage=$MAX_RAM_PERCENTAGE"

exec "$java" $jvm_opts $logging \
	$JAVA_OPTS \
	-jar "$GUMDROP_JAR" "$@"
