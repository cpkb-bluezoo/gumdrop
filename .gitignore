*~
*.swp
.DS_Store
.vscode

# External dependencies downloaded by 'ant resolve-deps'
lib/*.jar
!lib/README

# Local TLS certificates (generated by scripts/dev-tls-setup.*)
etc/localhost+*.pem
etc/localhost+*-key.pem
etc/localhost+*.p12
etc/localhost.pem
etc/localhost-key.pem
etc/keystore.p12
dist/container-home/conf/keystore.p12

# Generated Javadoc (built by CI, published to GitHub Pages)
doc/

test/integration/classes/
# TLS certificates/keystores generated by 'ant integration-setup'
test/integration/certs/
# Scratch files created by FTPClientIntegrationTest / FTPServerIntegrationTest runs
test/integration/ftp-data/
test/integration/ftp-server-data/
test/integration/results/
test/integration/webapp/WEB-INF/classes/
test/junit/lib/*.jar
!test/junit/lib/README
test/junit/classes/
test/junit/coverage/
test/junit/report/
test/junit/results/
build/
dist/
