*~
*.swp
.DS_Store
.vscode

# External dependencies downloaded by 'ant resolve-deps'
lib/*.jar
!lib/README

# Local TLS certificates and the development CA (generated by "ant tls-certs")
etc/tls/
dist/container-home/conf/tls/

# Generated Javadoc (built by CI, published to GitHub Pages)
doc/

test/integration/classes/
test/integration/coverage/
test/coverage-report/
# TLS certificates/keystores generated by 'ant integration-setup'
test/integration/certs/
# Scratch files created by FTPClientIntegrationTest / FTPServerIntegrationTest runs
test/integration/ftp-data/
test/integration/ftp-server-data/
test/integration/results/
test/integration/webapp/WEB-INF/classes/
test/integration/webapp-examples/WEB-INF/classes/
test/junit/lib/*.jar
!test/junit/lib/README
test/junit/classes/
test/junit/coverage/
test/junit/report/
test/junit/results/
test/guard/classes/
test/guard/results/
build/
dist/

# Generated class files (ant clean removes these)
web/WEB-INF/classes/
examples/**/*.class

# Benchmark harness: downloaded Netty jars, generated keystore, build output, results
test/benchmark/lib/
test/benchmark/certs/
test/benchmark/out/
test/benchmark/results/

# quic-interop-runner endpoint (test/quic-interop-runner): compiled classes,
# unit test results, and logs from local runner invocations
test/quic-interop-runner/classes/
test/quic-interop-runner/results/
test/quic-interop-runner/logs/
