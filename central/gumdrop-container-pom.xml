<?xml version="1.0" encoding="UTF-8"?>
<!--
  This POM declares Maven coordinates and the metadata Maven Central's
  Publisher API validates (name/description/url/licenses/developers/scm)
  for the "gumdrop-container" artifact (a self-contained bootstrap jar for
  launching gumdrop as a standalone process). It performs no build or
  deploy action of its own: Ant (build.xml) is the sole build tool, and
  this file is only consumed by scripts/publish-to-central.sh when
  assembling the Central upload bundle.

  Deliberately no <dependencies>: unlike gumdrop-pom.xml, the primary container
  artifact is a distribution zip with external lib/ jars. build.xml also builds
  a legacy gumdrop-container.jar fat jar (nested dependencies) for one release
  cycle; runtime class loading is handled by Bootstrap/DependencyClassLoader
  in either layout. Declaring Maven dependencies here would misrepresent the
  zip layout and could double-load jars for consumers of the fat jar.

  See gumdrop-pom.xml for the general notes on why this file exists
  separately from the root pom.xml, and on the SNAPSHOT version blocker.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.bluezoo</groupId>
    <artifactId>gumdrop-container</artifactId>
    <version>2.2.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Gumdrop Container</name>
    <description>Servlet container distribution for running Gumdrop as a standalone server process — primarily a zip with bin/, lib/, webapps/, and conf/ (lib/ layout), plus an optional legacy self-contained fat jar.</description>
    <url>https://github.com/cpkb-bluezoo/gumdrop</url>

    <licenses>
        <license>
            <name>GNU Lesser General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Chris Burdess</name>
            <email>dog@gnu.org</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/cpkb-bluezoo/gumdrop.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/cpkb-bluezoo/gumdrop.git</developerConnection>
        <url>https://github.com/cpkb-bluezoo/gumdrop</url>
    </scm>

</project>
