<project name='gumdrop' default='dist'>

  <!-- Project version -->
  <property name='version' value='2.2.1-SNAPSHOT'/>

  <!-- External dependency versions (sync with pom.xml and boms/* — Ant-only build) -->
  <property file='boms/versions.properties'/>
  <property name='gonzalez.jar' value='gonzalez-${gonzalez.version}.jar'/>
  <property name='jsonparser.jar' value='jsonparser-${jsonparser.version}.jar'/>
  <property name='agent15.jar' value='agent15-${agent15.version}.jar'/>
  <property name='hkdf.jar' value='hkdf-${hkdf.version}.jar'/>
  <property name='servlet.jar' value='javax.servlet-api-${javax.servlet.api.version}.jar'/>
  <property name='javamail.jar' value='javax.mail-${javax.mail.version}.jar'/>
  <property name='annotation.jar' value='javax.annotation-api-${javax.annotation.api.version}.jar'/>
  <property name='ejb.jar' value='javax.ejb-api-${javax.ejb.api.version}.jar'/>
  <property name='persistence.jar' value='javax.persistence-api-${javax.persistence.api.version}.jar'/>
  <property name='jaxws.jar' value='jaxws-api-${jaxws.api.version}.jar'/>

  <!-- Compiled classes: build/{core,mime,http,servlet,bootstrap,…}; release jars: dist/ -->
  <property name='build.dir' location='build'/>
  <property name='ant.services' location='ant/services'/>
  <property name='ant.modules' location='ant/modules'/>
  <property name='build.telemetry' location='${build.dir}/telemetry'/>
  <property name='build.core' location='${build.dir}/core'/>
  <property name='build.aggregator' location='${build.dir}/aggregator'/>
  <property name='build.mime.module' location='${build.dir}/mime'/>
  <property name='build.mailbox' location='${build.dir}/mailbox'/>
  <property name='build.http' location='${build.dir}/http'/>
  <property name='build.ldap' location='${build.dir}/ldap'/>
  <property name='build.servlet.module' location='${build.dir}/servlet'/>
  <property name='build.imap' location='${build.dir}/imap'/>
  <property name='build.smtp' location='${build.dir}/smtp'/>
  <property name='build.pop3' location='${build.dir}/pop3'/>
  <property name='build.ftp' location='${build.dir}/ftp'/>
  <property name='build.amqp' location='${build.dir}/amqp'/>
  <property name='build.mqtt' location='${build.dir}/mqtt'/>
  <property name='build.redis' location='${build.dir}/redis'/>
  <property name='build.grpc' location='${build.dir}/grpc'/>
  <property name='build.socks' location='${build.dir}/socks'/>
  <property name='build.webdav' location='${build.dir}/webdav'/>
  <property name='build.mdns' location='${build.dir}/mdns'/>
  <property name='src' location='src'/>
  <property name='lib' location='lib'/>
  <property name='build.bootstrap' location='${build.dir}/bootstrap'/>
  <property name='manager' location='manager'/>
  <property name='dist' location='dist'/>
  <property name='test' location='test'/>
  <property name='gumdrop.jar' location='${dist}/gumdrop.jar'/>
  <property name='gumdrop.core.jar' location='${dist}/gumdrop-core.jar'/>
  <property name='gumdrop.mime.jar' location='${dist}/gumdrop-mime.jar'/>
  <property name='gumdrop.mailbox.jar' location='${dist}/gumdrop-mailbox.jar'/>
  <property name='gumdrop.servlet.jar' location='${dist}/gumdrop-servlet.jar'/>
  <property name='gumdrop.imap.jar' location='${dist}/gumdrop-imap.jar'/>
  <property name='gumdrop.smtp.jar' location='${dist}/gumdrop-smtp.jar'/>
  <property name='gumdrop.pop3.jar' location='${dist}/gumdrop-pop3.jar'/>
  <property name='gumdrop.ftp.jar' location='${dist}/gumdrop-ftp.jar'/>
  <property name='gumdrop.amqp.jar' location='${dist}/gumdrop-amqp.jar'/>
  <property name='gumdrop.mqtt.jar' location='${dist}/gumdrop-mqtt.jar'/>
  <property name='gumdrop.redis.jar' location='${dist}/gumdrop-redis.jar'/>
  <property name='gumdrop.grpc.jar' location='${dist}/gumdrop-grpc.jar'/>
  <property name='gumdrop.socks.jar' location='${dist}/gumdrop-socks.jar'/>
  <property name='gumdrop.webdav.jar' location='${dist}/gumdrop-webdav.jar'/>
  <property name='gumdrop.mdns.jar' location='${dist}/gumdrop-mdns.jar'/>
  <property name='gumdrop-container.jar' location='${dist}/gumdrop-container.jar'/>
  <property name='gumdrop-container.zip' location='${dist}/gumdrop-container-${version}.zip'/>
  <property name='gumdrop.telemetry.jar' location='${dist}/gumdrop-telemetry.jar'/>
  <property name='gumdrop.http.jar' location='${dist}/gumdrop-http.jar'/>
  <property name='gumdrop.ldap.jar' location='${dist}/gumdrop-ldap.jar'/>
  <property name='container.home' location='${dist}/gumdrop-${version}'/>
  <property name='container.home.stable' location='${dist}/container-home'/>
  <property name='manager.war' location='${dist}/manager.war'/>
  <!--
    Java version compatibility settings.
    Gumdrop v2 requires Java 17 (LTS) as the minimum baseline.
    
    Build strategy:
    - Main code compiled with -release 17
    - module-info.java compiled separately with -release 17 (JPMS)
  -->
  <property name='java.release.version' value='17'/>
  
  <!-- JUnit dependencies -->
  <property name='junit.jar' value='junit-4.13.2.jar'/>
  <property name='hamcrest.jar' value='hamcrest-3.0.jar'/>

  <import file='ant/compile-modules.xml'/>

  <!-- Remove compiled classes and build directories -->
  <!-- Note: does NOT delete doc/ directory to avoid constant javadoc churn in git -->
  <!-- Use 'ant clean-javadoc' explicitly if you need to regenerate all documentation -->
  <target name='clean-legacy-dirs' description='Remove obsolete top-level build-* output from earlier layouts'>
    <delete dir='build-bootstrap' quiet='true'/>
    <delete dir='build-core' quiet='true'/>
    <delete dir='build-mime' quiet='true'/>
    <delete dir='build-mailbox' quiet='true'/>
    <delete dir='build-http' quiet='true'/>
    <delete dir='build-servlet' quiet='true'/>
    <delete dir='build-telemetry' quiet='true'/>
    <delete dir='build-ldap' quiet='true'/>
    <delete dir='build-imap' quiet='true'/>
    <delete dir='build-smtp' quiet='true'/>
    <delete dir='build-pop3' quiet='true'/>
    <delete dir='build-ftp' quiet='true'/>
    <delete dir='build-amqp' quiet='true'/>
    <delete dir='build-mqtt' quiet='true'/>
    <delete dir='build-redis' quiet='true'/>
    <delete dir='build-grpc' quiet='true'/>
    <delete dir='build-socks' quiet='true'/>
    <delete dir='build-webdav' quiet='true'/>
    <delete dir='build-mdns' quiet='true'/>
  </target>

  <target name='clean' depends='clean-junit,clean-integration,clean-legacy-dirs'>
    <delete dir='${build.dir}'/>
    <delete dir='${dist}'/>
    <delete dir='${manager}/WEB-INF/classes'/>
    <delete dir='${test}/cluster/WEB-INF/classes'/>
  </target>

  <target name='clean-junit'>
    <delete dir='${test}/junit/classes'/>
    <delete dir='${test}/junit/results'/>
  </target>

  <target name='clean-integration'>
    <delete dir='${test}/integration/classes'/>
    <delete dir='${test}/integration/results'/>
    <delete dir='${test}/integration/webapp/WEB-INF/classes'/>
  </target>

  <!-- Download compile/runtime dependencies (versions from boms/versions.properties) -->
  <target name='resolve-deps' description='Download external dependencies'>
    <mkdir dir='${lib}'/>
    <get src='https://github.com/cpkb-bluezoo/jsonparser/releases/download/v${jsonparser.version}/jsonparser-${jsonparser.version}.jar'
         dest='${lib}/${jsonparser.jar}' skipexisting='true'/>
    <get src='https://github.com/cpkb-bluezoo/gonzalez/releases/download/v${gonzalez.version}/gonzalez-${gonzalez.version}.jar'
         dest='${lib}/${gonzalez.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/tech/kwik/agent15/${agent15.version}/agent15-${agent15.version}.jar'
         dest='${lib}/${agent15.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/at/favre/lib/hkdf/${hkdf.version}/hkdf-${hkdf.version}.jar'
         dest='${lib}/${hkdf.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/javax/servlet/javax.servlet-api/${javax.servlet.api.version}/javax.servlet-api-${javax.servlet.api.version}.jar'
         dest='${lib}/${servlet.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/com/sun/mail/javax.mail/${javax.mail.version}/javax.mail-${javax.mail.version}.jar'
         dest='${lib}/${javamail.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/javax/annotation/javax.annotation-api/${javax.annotation.api.version}/javax.annotation-api-${javax.annotation.api.version}.jar'
         dest='${lib}/${annotation.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/javax/ejb/javax.ejb-api/${javax.ejb.api.version}/javax.ejb-api-${javax.ejb.api.version}.jar'
         dest='${lib}/${ejb.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/javax/persistence/javax.persistence-api/${javax.persistence.api.version}/javax.persistence-api-${javax.persistence.api.version}.jar'
         dest='${lib}/${persistence.jar}' skipexisting='true'/>
    <get src='https://repo1.maven.org/maven2/javax/xml/ws/jaxws-api/${jaxws.api.version}/jaxws-api-${jaxws.api.version}.jar'
         dest='${lib}/${jaxws.jar}' skipexisting='true'/>
  </target>

  <!-- Refresh the bundled Mozilla Public Suffix List (SEC-048). Run
       periodically to pick up new/changed TLD rules; always overwrites
       (no skipexisting), unlike resolve-deps' pinned release jars. -->
  <target name='update-psl' description='Fetch the latest Public Suffix List'>
    <get src='https://publicsuffix.org/list/public_suffix_list.dat'
         dest='${src}/org/bluezoo/gumdrop/smtp/auth/public_suffix_list.dat'/>
    <echo message='Updated public_suffix_list.dat from publicsuffix.org'/>
  </target>

  <!-- Optional OTLP/JSONL telemetry export (ServiceLoader SPI); sources mapped in build, not separate src tree -->
  <target name='build-telemetry' depends='build'
          description='Compile gumdrop-telemetry export jar'>
    <mkdir dir='${build.telemetry}'/>
    <javac srcdir='${src}' destdir='${build.telemetry}' debug='true'
           release='${java.release.version}'
           sourcepath=''
           includeantruntime='false'
           createMissingPackageInfoClass='false'>
      <classpath refid='module.compile.classpath'/>
      <include name='org/bluezoo/gumdrop/telemetry/json/**'/>
      <include name='org/bluezoo/gumdrop/telemetry/export/**'/>
      <include name='org/bluezoo/gumdrop/telemetry/otlp/**'/>
    </javac>
    <copy todir='${build.telemetry}'>
      <fileset dir='${src}'>
        <include name='org/bluezoo/gumdrop/telemetry/json/**'/>
        <include name='org/bluezoo/gumdrop/telemetry/export/**'/>
        <exclude name='**/*.java'/>
      </fileset>
      <fileset dir='${ant.services}/telemetry' includes='META-INF/**'/>
    </copy>
  </target>

  <!-- LDAPRealm (depends on ldap client in core) -->
  <target name='build-ldap' depends='build-core-main'
          description='Compile gumdrop-ldap module jar (LDAPRealm)'>
    <mkdir dir='${build.ldap}'/>
    <javac srcdir='${src}' destdir='${build.ldap}' debug='true'
           release='${java.release.version}'
           sourcepath=''
           includeantruntime='false'
           createMissingPackageInfoClass='false'>
      <classpath refid='core.compile.classpath'/>
      <include name='org/bluezoo/gumdrop/auth/ldap/**'/>
    </javac>
  </target>

  <target name='build-modules' depends='build,build-telemetry,build-ldap'
          description='Compile optional module source sets (telemetry, ldap realm)'/>

  <target name='jar-core' depends='build'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.core.jar}'>
      <fileset dir='${build.core}'>
        <exclude name='org/bluezoo/gumdrop/Bootstrap.class'/>
        <exclude name='org/bluezoo/gumdrop/Bootstrap$*.class'/>
        <exclude name='org/bluezoo/gumdrop/DependencyClassLoader.class'/>
        <exclude name='org/bluezoo/gumdrop/DependencyClassLoader$*.class'/>
        <exclude name='org/bluezoo/gumdrop/ContainerClassLoader.class'/>
        <exclude name='org/bluezoo/gumdrop/ContainerClassLoader$*.class'/>
      </fileset>
    </jar>
  </target>

  <target name='jar-mime' depends='build'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.mime.jar}' basedir='${build.mime.module}'/>
  </target>

  <target name='jar-servlet' depends='build'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.servlet.jar}' basedir='${build.servlet.module}'/>
  </target>

  <target name='jar-mailbox' depends='build'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.mailbox.jar}' basedir='${build.mailbox}'/>
  </target>

  <target name='jar-protocol-modules' depends='build'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.imap.jar}' basedir='${build.imap}'/>
    <jar destfile='${gumdrop.smtp.jar}' basedir='${build.smtp}'/>
    <jar destfile='${gumdrop.pop3.jar}' basedir='${build.pop3}'/>
    <jar destfile='${gumdrop.ftp.jar}' basedir='${build.ftp}'/>
    <jar destfile='${gumdrop.amqp.jar}' basedir='${build.amqp}'/>
    <jar destfile='${gumdrop.mqtt.jar}' basedir='${build.mqtt}'/>
    <jar destfile='${gumdrop.redis.jar}' basedir='${build.redis}'/>
    <jar destfile='${gumdrop.grpc.jar}' basedir='${build.grpc}'/>
    <jar destfile='${gumdrop.socks.jar}' basedir='${build.socks}'/>
    <jar destfile='${gumdrop.webdav.jar}' basedir='${build.webdav}'/>
    <jar destfile='${gumdrop.mdns.jar}' basedir='${build.mdns}'/>
  </target>

  <target name='jar-telemetry' depends='build-telemetry'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.telemetry.jar}' basedir='${build.telemetry}'/>
  </target>

  <target name='jar-http' depends='build-http-module'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.http.jar}' basedir='${build.http}'/>
  </target>

  <target name='jar-ldap' depends='build-ldap'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.ldap.jar}' basedir='${build.ldap}'/>
  </target>

  <!-- gumdrop.jar: all-in-one library merge (Phase 2.11) -->
  <!-- Bootstrap and ContainerClassLoader are excluded: they live in the container jar -->
  <target name='jar' depends='build,manager-war-digest,build-modules,build-jpms,jar-core,jar-mime,jar-mailbox,jar-http,jar-servlet,jar-protocol-modules,jar-telemetry,jar-ldap'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop.jar}'>
      <fileset dir='${build.core}'>
        <exclude name='org/bluezoo/gumdrop/Bootstrap.class'/>
        <exclude name='org/bluezoo/gumdrop/Bootstrap$*.class'/>
        <exclude name='org/bluezoo/gumdrop/DependencyClassLoader.class'/>
        <exclude name='org/bluezoo/gumdrop/DependencyClassLoader$*.class'/>
        <exclude name='org/bluezoo/gumdrop/ContainerClassLoader.class'/>
        <exclude name='org/bluezoo/gumdrop/ContainerClassLoader$*.class'/>
        <exclude name='module-info.class'/>
      </fileset>
      <fileset dir='${build.mime.module}' excludes='module-info.class'/>
      <fileset dir='${build.mailbox}' excludes='module-info.class'/>
      <fileset dir='${build.http}' excludes='module-info.class'/>
      <fileset dir='${build.servlet.module}' excludes='module-info.class'/>
      <fileset dir='${build.imap}' excludes='module-info.class'/>
      <fileset dir='${build.smtp}' excludes='module-info.class'/>
      <fileset dir='${build.pop3}' excludes='module-info.class'/>
      <fileset dir='${build.ftp}' excludes='module-info.class'/>
      <fileset dir='${build.amqp}' excludes='module-info.class'/>
      <fileset dir='${build.mqtt}' excludes='module-info.class'/>
      <fileset dir='${build.redis}' excludes='module-info.class'/>
      <fileset dir='${build.grpc}' excludes='module-info.class'/>
      <fileset dir='${build.socks}' excludes='module-info.class'/>
      <fileset dir='${build.webdav}' excludes='module-info.class'/>
      <fileset dir='${build.mdns}' excludes='module-info.class'/>
      <fileset dir='${build.telemetry}' excludes='module-info.class'/>
      <fileset dir='${build.ldap}' excludes='module-info.class'/>
      <fileset dir='${build.aggregator}' includes='module-info.class'/>
    </jar>
  </target>

  <!-- Compile bootstrap / classloader classes (shared by fat jar and gumdrop-bootstrap.jar) -->
  <target name='compile-bootstrap' depends='jar'>
    <mkdir dir='${build.bootstrap}'/>
    <javac srcdir='${src}' destdir='${build.bootstrap}' debug='true'
           release='${java.release.version}'
           sourcepath=''
           includeantruntime='false'>
      <include name="org/bluezoo/gumdrop/Bootstrap.java"/>
      <include name="org/bluezoo/gumdrop/DependencyClassLoader.java"/>
      <include name="org/bluezoo/gumdrop/ContainerClassLoader.java"/>
      <include name="org/bluezoo/gumdrop/util/IteratorEnumeration.java"/>
      <include name="org/bluezoo/gumdrop/util/JarInputStream.java"/>
    </javac>
  </target>

  <!-- Slim bootstrap jar for lib/ distribution layout (no nested dependencies) -->
  <target name='bootstrap-jar' depends='compile-bootstrap'>
    <mkdir dir='${dist}/lib'/>
    <jar destfile='${dist}/lib/gumdrop-bootstrap.jar'>
      <fileset dir='${build.bootstrap}'>
        <include name='org/bluezoo/gumdrop/Bootstrap.class'/>
        <include name='org/bluezoo/gumdrop/Bootstrap$*.class'/>
        <include name='org/bluezoo/gumdrop/DependencyClassLoader.class'/>
        <include name='org/bluezoo/gumdrop/DependencyClassLoader$*.class'/>
        <include name='org/bluezoo/gumdrop/ContainerClassLoader.class'/>
        <include name='org/bluezoo/gumdrop/ContainerClassLoader$*.class'/>
        <include name='org/bluezoo/gumdrop/util/IteratorEnumeration.class'/>
        <include name='org/bluezoo/gumdrop/util/JarInputStream.class'/>
      </fileset>
      <manifest>
        <attribute name='Main-Class' value='org.bluezoo.gumdrop.Bootstrap'/>
        <attribute name='Container-Layout' value='lib'/>
        <attribute name='Container-Jar' value='gumdrop.jar'/>
      </manifest>
    </jar>
  </target>

  <!-- The build/bootstrap directory holds Bootstrap classes and, for the legacy fat jar, nested copies. -->
  <target name='build-bootstrap' depends='compile-bootstrap'>
    <copy todir='${build.bootstrap}' file='${gumdrop.jar}'/>
    <copy todir='${build.bootstrap}'>
      <fileset dir='${lib}'>
        <include name='${gonzalez.jar}'/>
        <include name='${jsonparser.jar}'/>
        <include name='${agent15.jar}'/>
        <include name='${hkdf.jar}'/>
        <include name='${servlet.jar}'/>
        <include name='${javamail.jar}'/>
        <include name='${annotation.jar}'/>
        <include name='${ejb.jar}'/>
        <include name='${persistence.jar}'/>
        <include name='${jaxws.jar}'/>
      </fileset>
    </copy>
  </target>

  <!-- Legacy self-contained fat jar (deprecated; use container-zip / lib layout) -->
  <target name='container-jar' depends='build-bootstrap' description='Build legacy fat gumdrop-container.jar'>
    <mkdir dir='${dist}'/>
    <jar destfile='${gumdrop-container.jar}' basedir='${build.bootstrap}'>
      <manifest>
        <attribute name='Main-Class' value='org.bluezoo.gumdrop.Bootstrap'/>
        <attribute name='Container-Jar' value='gumdrop.jar'/>
        <attribute name='Container-Dependencies' value='${servlet.jar} ${javamail.jar} ${annotation.jar} ${ejb.jar} ${persistence.jar} ${jaxws.jar} ${gonzalez.jar} ${jsonparser.jar} ${agent15.jar} ${hkdf.jar}'/>
      </manifest>
    </jar>
  </target>

  <!-- manager.war contains the manager web application -->
  <target name='manager-war'>
    <mkdir dir='${dist}'/>
    <jar destfile='${manager.war}' basedir='${manager}'>
      <manifest>
        <attribute name='Implementation-Title' value='Gumdrop Manager'/>
        <attribute name='Implementation-Version' value='${version}'/>
        <attribute name='Implementation-Vendor' value='org.bluezoo'/>
      </manifest>
    </jar>
  </target>

  <!-- Trust pin for the manager webapp (bundled in gumdrop.jar for Context) -->
  <target name='manager-war-digest' depends='manager-war'>
    <mkdir dir='${build.core}/META-INF'/>
    <checksum file='${manager.war}' algorithm='MD5' property='manager.war.md5'/>
    <echo file='${build.core}/META-INF/gumdrop-manager-war.md5' message='${manager.war.md5}'/>
  </target>

  <!-- Production install tree: bin/, lib/, webapps/, conf/ -->
  <target name='assemble-container' depends='jar,bootstrap-jar,manager-war,resolve-deps'
          description='Assemble servlet container distribution directory'>
    <delete dir='${container.home}' quiet='true'/>
    <mkdir dir='${container.home}/bin'/>
    <mkdir dir='${container.home}/lib'/>
    <mkdir dir='${container.home}/webapps'/>
    <mkdir dir='${container.home}/conf'/>
    <copy file='bin/gumdrop.sh' todir='${container.home}/bin'/>
    <copy file='bin/gumdrop.bat' todir='${container.home}/bin'/>
    <chmod file='${container.home}/bin/gumdrop.sh' perm='ugo+rx'/>
    <copy file='${dist}/lib/gumdrop-bootstrap.jar' todir='${container.home}/lib'/>
    <copy file='${gumdrop.core.jar}' tofile='${container.home}/lib/gumdrop-core.jar'/>
    <copy file='${gumdrop.http.jar}' tofile='${container.home}/lib/gumdrop-http.jar'/>
    <copy file='${gumdrop.servlet.jar}' tofile='${container.home}/lib/gumdrop-servlet.jar'/>
    <copy file='${gumdrop.mime.jar}' tofile='${container.home}/lib/gumdrop-mime.jar'/>
    <copy todir='${container.home}/lib'>
      <fileset dir='${lib}'>
        <include name='${gonzalez.jar}'/>
        <include name='${jsonparser.jar}'/>
        <include name='${agent15.jar}'/>
        <include name='${hkdf.jar}'/>
        <include name='${servlet.jar}'/>
        <include name='${javamail.jar}'/>
        <include name='${annotation.jar}'/>
        <include name='${ejb.jar}'/>
        <include name='${persistence.jar}'/>
        <include name='${jaxws.jar}'/>
      </fileset>
    </copy>
    <copy file='${manager.war}' tofile='${container.home}/webapps/manager.war'/>
    <copy file='conf/gumdroprc.xml.example' todir='${container.home}/conf'/>
    <copy file='etc/realm-servlet.xml' tofile='${container.home}/conf/realm-servlet.xml'/>
    <copy file='logging.properties' todir='${container.home}'/>
    <copy todir='${container.home}/webapps/ROOT'>
      <fileset dir='web'/>
    </copy>
    <copy file='COPYING' tofile='${container.home}/LICENSE'/>
    <copy file='README.md' todir='${container.home}'/>
    <!-- Stable path for Docker / CI regardless of version string -->
    <delete dir='${container.home.stable}' quiet='true'/>
    <copy todir='${container.home.stable}'>
      <fileset dir='${container.home}'/>
    </copy>
  </target>

  <target name='container-zip' depends='assemble-container'
          description='Zip the servlet container distribution'>
    <zip destfile='${gumdrop-container.zip}' basedir='${dist}'
         includes='gumdrop-${version}/**'/>
  </target>

  <target name='dist' depends='container-zip,container-jar' description='Build all distribution artifacts'/>

  <!-- Release target creates versioned artifacts for distribution -->
  <target name='release' depends='dist' description='Create versioned release artifacts'>
    <copy file='${gumdrop.jar}' tofile='${dist}/gumdrop-${version}.jar'/>
    <copy file='${gumdrop.telemetry.jar}' tofile='${dist}/gumdrop-telemetry-${version}.jar'/>
    <copy file='${gumdrop.core.jar}' tofile='${dist}/gumdrop-core-${version}.jar'/>
    <copy file='${gumdrop.mime.jar}' tofile='${dist}/gumdrop-mime-${version}.jar'/>
    <copy file='${gumdrop.mailbox.jar}' tofile='${dist}/gumdrop-mailbox-${version}.jar'/>
    <copy file='${gumdrop.servlet.jar}' tofile='${dist}/gumdrop-servlet-${version}.jar'/>
    <copy file='${gumdrop.http.jar}' tofile='${dist}/gumdrop-http-${version}.jar'/>
    <copy file='${gumdrop.imap.jar}' tofile='${dist}/gumdrop-imap-${version}.jar'/>
    <copy file='${gumdrop.smtp.jar}' tofile='${dist}/gumdrop-smtp-${version}.jar'/>
    <copy file='${gumdrop.pop3.jar}' tofile='${dist}/gumdrop-pop3-${version}.jar'/>
    <copy file='${gumdrop.ftp.jar}' tofile='${dist}/gumdrop-ftp-${version}.jar'/>
    <copy file='${gumdrop.amqp.jar}' tofile='${dist}/gumdrop-amqp-${version}.jar'/>
    <copy file='${gumdrop.mqtt.jar}' tofile='${dist}/gumdrop-mqtt-${version}.jar'/>
    <copy file='${gumdrop.redis.jar}' tofile='${dist}/gumdrop-redis-${version}.jar'/>
    <copy file='${gumdrop.grpc.jar}' tofile='${dist}/gumdrop-grpc-${version}.jar'/>
    <copy file='${gumdrop.socks.jar}' tofile='${dist}/gumdrop-socks-${version}.jar'/>
    <copy file='${gumdrop.webdav.jar}' tofile='${dist}/gumdrop-webdav-${version}.jar'/>
    <copy file='${gumdrop.mdns.jar}' tofile='${dist}/gumdrop-mdns-${version}.jar'/>
    <copy file='${gumdrop.ldap.jar}' tofile='${dist}/gumdrop-ldap-${version}.jar'/>
    <copy file='${gumdrop-container.jar}' tofile='${dist}/gumdrop-container-${version}.jar'/>
    <copy file='${gumdrop-container.zip}' tofile='${dist}/gumdrop-container-${version}.zip'/>
    <copy file='${manager.war}' tofile='${dist}/gumdrop-manager-${version}.war'/>
    <echo message='Release artifacts created:'/>
    <echo message='  ${dist}/gumdrop-${version}.jar (core library)'/>
    <echo message='  ${dist}/gumdrop-container-${version}.zip (container distribution)'/>
    <echo message='  ${dist}/gumdrop-container-${version}.jar (legacy fat jar)'/>
    <echo message='  ${dist}/gumdrop-manager-${version}.war (manager webapp)'/>
  </target>

  <!-- Sources jar for Maven Central (core gumdrop.jar). No depends: archiving
       .java files needs no compile step first. -->
  <target name='release-sources'>
    <mkdir dir='${dist}'/>
    <jar jarfile='${dist}/gumdrop-${version}-sources.jar'>
      <fileset dir='${src}'>
        <exclude name='module-info.java'/>
      </fileset>
    </jar>
  </target>

  <!-- Sources jar for Maven Central (gumdrop-container.jar) - just the
       bootstrap classes it actually adds on top of gumdrop.jar, mirroring
       build/bootstrap's own include list exactly. -->
  <target name='release-sources-container'>
    <mkdir dir='${dist}'/>
    <jar jarfile='${dist}/gumdrop-container-${version}-sources.jar'>
      <fileset dir='${src}'>
        <include name='org/bluezoo/gumdrop/Bootstrap.java'/>
        <include name='org/bluezoo/gumdrop/DependencyClassLoader.java'/>
        <include name='org/bluezoo/gumdrop/ContainerClassLoader.java'/>
        <include name='org/bluezoo/gumdrop/util/IteratorEnumeration.java'/>
        <include name='org/bluezoo/gumdrop/util/JarInputStream.java'/>
      </fileset>
    </jar>
  </target>

  <!-- "Sources" jar for Maven Central (gumdrop-manager.war) - manager-war
       has no separate compile step, so the closest analog to "sources"
       for this WAR is the raw manager/ webapp tree it's jarred from
       as-is. -->
  <target name='release-sources-manager'>
    <mkdir dir='${dist}'/>
    <jar jarfile='${dist}/gumdrop-manager-${version}-sources.jar' basedir='${manager}'/>
  </target>

  <target name='release-sources-all' depends='release-sources,release-sources-container,release-sources-manager'/>

  <!-- Javadoc jar for Maven Central - one shared javadoc build (covering
       the core gumdrop source tree only, since that's the only artifact
       with real Java API surface) reused for all three published
       artifacts; see scripts/publish-to-central.sh, which copies/renames
       this single jar into each artifact's bundle. Depends on the
       existing javadoc target, which already builds incrementally and
       runs in classpath mode (see its own comments). -->
  <target name='release-javadoc' depends='javadoc'>
    <mkdir dir='${dist}'/>
    <jar jarfile='${dist}/gumdrop-${version}-javadoc.jar' basedir='doc'/>
  </target>

  <!-- Everything scripts/publish-to-central.sh needs in ${dist}: the
       three release jars/war (from 'release'), their three sources jars,
       and the one shared javadoc jar. -->
  <target name='release-central' depends='release,release-sources-all,release-javadoc'
          description='Build all artifacts needed for a Maven Central publish'/>

  <!-- Check if javadoc needs to be regenerated -->
  <target name='javadoc-check'>
    <uptodate property='javadoc.uptodate' targetfile='doc/index.html'>
      <srcfiles dir='${src}' includes='**/*.java'/>
    </uptodate>
  </target>

  <!-- Generate Javadoc API documentation (only if sources have changed) -->
  <!-- Use a fileset (no sourcepath) and exclude module-info.java so Javadoc runs
       in classpath mode. With sourcepath, Javadoc would enter module mode and fail
       resolving requires org.bluezoo.gonzalez / org.bluezoo.json (those JARs are
       not on the module path and may not be modular). -->
  <target name='javadoc' depends='javadoc-check' unless='javadoc.uptodate'
          description='Generate Javadoc API documentation (incremental)'>
    <mkdir dir='doc'/>
    <javadoc destdir='doc'
             author='true'
             version='true'
             use='true'
             splitindex='true'
             windowtitle='Gumdrop API'
             doctitle='Gumdrop API Documentation'
             header='&lt;b&gt;Gumdrop&lt;/b&gt;'
             bottom='&lt;small&gt;Gumdrop is free software distributed under the GNU Lesser General Public License. Copyright &amp;copy; 2005, 2025 Chris Burdess.&lt;/small&gt;'
             source='${java.release.version}'
             failonerror='false'
             additionalparam='-Xdoclint:none'>
      <fileset dir='${src}' includes='**/*.java' excludes='module-info.java'/>
      <classpath>
        <pathelement location='${lib}/${gonzalez.jar}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${lib}/${agent15.jar}'/>
        <pathelement location='${lib}/${hkdf.jar}'/>
        <pathelement location='${lib}/${servlet.jar}'/>
        <pathelement location='${lib}/${javamail.jar}'/>
        <pathelement location='${lib}/${annotation.jar}'/>
        <pathelement location='${lib}/${ejb.jar}'/>
        <pathelement location='${lib}/${persistence.jar}'/>
        <pathelement location='${lib}/${jaxws.jar}'/>
      </classpath>
    </javadoc>
  </target>

  <!-- Force regeneration of all Javadoc (bypasses uptodate check) -->
  <target name='javadoc-force' depends='clean-javadoc,javadoc'
          description='Force complete regeneration of Javadoc'/>

  <!-- Clean generated documentation -->
  <target name='clean-javadoc' description='Remove generated Javadoc'>
    <delete dir='doc'/>
  </target>

  <target name='cluster-test'>
    <mkdir dir='${test}/cluster/WEB-INF/classes'/>
    <javac srcdir='${test}/cluster' destdir='${test}/cluster/WEB-INF/classes' debug='true'
           release='${java.release.version}'
           includeantruntime='false'>
      <classpath>
        <pathelement location='${lib}/${servlet.jar}'/>
      </classpath>
    </javac>
  </target>

  <target name='junit-build' depends='build-modules'>
    <mkdir dir='${test}/junit/classes'/>
    <javac srcdir='${test}/junit/src' destdir='${test}/junit/classes' debug='true'
           release='${java.release.version}'
           includeantruntime='false'>
      <classpath>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <path refid='server.classes'/>
        <pathelement location='${lib}/${gonzalez.jar}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${lib}/${agent15.jar}'/>
        <pathelement location='${lib}/${hkdf.jar}'/>
        <pathelement location='${lib}/${javamail.jar}'/>
        <pathelement location='${lib}/${servlet.jar}'/>
        <pathelement location='${lib}/${jsp.jar}'/>
      </classpath>
    </javac>
    <copy todir='${test}/junit/classes'>
      <fileset dir='${test}/junit/src'>
        <include name='**/*.eml'/>
      </fileset>
    </copy>
  </target>

  <target name='junit-test' depends='junit-build'>
    <mkdir dir='${test}/junit/results'/>
    <junit printsummary='yes' haltonfailure='yes' haltonerror='yes'>
      <classpath>
        <pathelement location='${test}/junit/classes'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
        <path refid='server.classes'/>
        <pathelement location='${lib}/${gonzalez.jar}'/>
        <pathelement location='${lib}/${jsonparser.jar}'/>
        <pathelement location='${lib}/${agent15.jar}'/>
        <pathelement location='${lib}/${hkdf.jar}'/>
        <pathelement location='${lib}/${javamail.jar}'/>
        <pathelement location='${lib}/${servlet.jar}'/>
        <pathelement location='${lib}/${jsp.jar}'/>
      </classpath>
      <batchtest fork="yes" todir="${test}/junit/results">
        <fileset dir="${test}/junit/src">
          <include name="**/*Test.java" />
        </fileset>
      </batchtest>
      <formatter type="plain" />
      <!-- Also stream full per-test failure detail (stack traces,
           assertion messages) straight to the console, not just the
           per-class summary line: otherwise a CI failure gives no way
           to tell what actually broke without re-running locally, since
           CI doesn't upload the file-based reports above as artifacts. -->
      <formatter type="plain" usefile="false" />
      <!--formatter type="xml" /-->
    </junit>
  </target>

  <!-- Main test target that runs all available tests -->
  <target name='test' depends='junit-test' description='Run all unit tests'>
  </target>

  <!-- Phase 3: verify modular jars resolve on the module path -->
  <path id='jpms.smoke.modulepath'>
    <pathelement location='${dist}/gumdrop-core.jar'/>
    <pathelement location='${dist}/gumdrop-mime.jar'/>
    <pathelement location='${dist}/gumdrop-http.jar'/>
    <pathelement location='${dist}/gumdrop-servlet.jar'/>
    <pathelement location='${lib}/${gonzalez.jar}'/>
    <pathelement location='${lib}/${jsonparser.jar}'/>
    <pathelement location='${lib}/${agent15.jar}'/>
    <pathelement location='${lib}/${hkdf.jar}'/>
    <pathelement location='${lib}/${servlet.jar}'/>
  </path>

  <target name='jpms-smoke-test' depends='jar'
          description='Validate servlet-closure modular jars on the module path'>
    <exec executable='${java.home}/bin/java' failonerror='true'>
      <arg value='--validate-modules'/>
      <arg value='-p'/>
      <arg pathref='jpms.smoke.modulepath'/>
    </exec>
    <echo>JPMS smoke test: servlet closure modules resolve on the module path</echo>
  </target>

  <!-- Build integration tests -->
  <target name='integration-build' depends='build-modules'>
    <mkdir dir='${test}/integration/classes'/>
    <javac srcdir='${test}/integration/src'
           destdir='${test}/integration/classes'
           release='${java.release.version}'
           includeantruntime='false'
           debug='true'>
      <classpath>
        <path refid='server.classes'/>
        <pathelement location='${test}/junit/lib/${junit.jar}'/>
        <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
        <pathelement location='${lib}/${javamail.jar}'/>
        <pathelement location='${lib}/${servlet.jar}'/>
      </classpath>
    </javac>
  </target>

  <!-- Common integration test classpath -->
  <path id='integration.classpath'>
    <pathelement location='${test}/integration/classes'/>
    <pathelement location='${test}/junit/lib/${junit.jar}'/>
    <pathelement location='${test}/junit/lib/${hamcrest.jar}'/>
    <path refid='server.classes'/>
    <pathelement location='${lib}/${gonzalez.jar}'/>
    <pathelement location='${lib}/${jsonparser.jar}'/>
    <pathelement location='${lib}/${agent15.jar}'/>
    <pathelement location='${lib}/${hkdf.jar}'/>
    <pathelement location='${lib}/${javamail.jar}'/>
    <pathelement location='${lib}/${servlet.jar}'/>
  </path>

  <!-- Set up test fixtures (certificates, directories, etc.) -->
  <target name='integration-setup' depends='integration-build'
          description='Set up integration test fixtures'>
    <java classname='org.bluezoo.gumdrop.TestFixtureSetup'
          classpathref='integration.classpath'
          failonerror='true'
          fork='true'>
    </java>
  </target>

  <!-- Common JUnit settings for integration tests with XML reporting -->
  <macrodef name='integration-junit'>
    <attribute name='includes'/>
    <sequential>
      <mkdir dir='${test}/integration/results/xml'/>
      <mkdir dir='${test}/integration/results/reports'/>
      <junit printsummary='yes' haltonfailure='no' fork='yes'
             showoutput='true' logfailedtests='true'>
        <classpath refid='integration.classpath'/>
        <batchtest fork='yes' todir='${test}/integration/results/xml'>
          <fileset dir='${test}/integration/src'>
            <include name='@{includes}'/>
          </fileset>
        </batchtest>
        <!-- Console output for immediate feedback -->
        <formatter type='plain' usefile='false'/>
        <!-- XML output for CI/CD and HTML report generation -->
        <formatter type='xml'/>
        <!-- System properties for test configuration -->
        <sysproperty key='test.results.dir' value='${test}/integration/results'/>
      </junit>
    </sequential>
  </macrodef>

  <!-- Run HTTP integration tests (needs TLS keystore for HTTPS) -->
  <target name='integration-test-http' depends='integration-setup'
          description='Run HTTP server integration tests'>
    <integration-junit includes='**/http/*IntegrationTest.java'/>
  </target>

  <!-- Run HTTP client integration tests (needs TLS keystore for h2 over TLS) -->
  <target name='integration-test-http-client' depends='integration-setup'
          description='Run HTTP client integration tests (h1.1, h2, h3)'>
    <integration-junit includes='**/http/client/*IntegrationTest.java'/>
  </target>

  <!-- Run SMTP integration tests (needs TLS keystore for SMTPS/STARTTLS) -->
  <target name='integration-test-smtp' depends='integration-setup'
          description='Run SMTP server integration tests'>
    <integration-junit includes='**/smtp/**/*IntegrationTest.java'/>
  </target>

  <!-- Run POP3 integration tests -->
  <target name='integration-test-pop3' depends='integration-build'
          description='Run POP3 server integration tests'>
    <integration-junit includes='**/pop3/*IntegrationTest.java'/>
  </target>

  <!-- Run IMAP integration tests -->
  <target name='integration-test-imap' depends='integration-build'
          description='Run IMAP server integration tests'>
    <integration-junit includes='**/imap/*IntegrationTest.java'/>
  </target>

  <!-- Run FTP integration tests -->
  <target name='integration-test-ftp' depends='integration-build'
          description='Run FTP server integration tests'>
    <integration-junit includes='**/ftp/**/*IntegrationTest.java'/>
  </target>

  <!-- Run servlet container integration tests -->
  <target name='integration-test-servlet' depends='integration-build'
          description='Run servlet container integration tests'>
    <!-- Copy test servlet and filter classes to webapp WEB-INF/classes -->
    <mkdir dir='${test}/integration/webapp/WEB-INF/classes'/>
    <copy todir='${test}/integration/webapp/WEB-INF/classes'>
      <fileset dir='${test}/integration/classes'>
        <include name='**/servlet/TestServlet.class'/>
        <include name='**/servlet/TestServlet$*.class'/>
        <include name='**/servlet/TestFilter.class'/>
      </fileset>
    </copy>
    <integration-junit includes='**/servlet/*IntegrationTest.java'/>
  </target>

  <!-- Run telemetry integration tests -->
  <target name='integration-test-telemetry' depends='integration-build'
          description='Run telemetry integration tests'>
    <integration-junit includes='**/telemetry/*IntegrationTest.java'/>
  </target>

  <!-- Run buffer handling integration tests (needs TLS keystore for secure variant) -->
  <target name='integration-test-buffer' depends='integration-setup'
          description='Run buffer handling integration tests'>
    <integration-junit includes='**/buffer/*IntegrationTest.java'/>
  </target>

  <!-- Run TLS/certificate integration tests -->
  <target name='integration-test-tls' depends='integration-build'
          description='Run TLS certificate integration tests'>
    <integration-junit includes='**/TestCertificateManagerTest.java'/>
  </target>

  <!-- Run WebSocket integration tests -->
  <target name='integration-test-websocket' depends='integration-build'
          description='Run WebSocket server integration tests'>
    <integration-junit includes='**/websocket/*IntegrationTest.java'/>
  </target>

  <!-- Run DTLS integration tests (needs TLS keystore/truststore, issue #190) -->
  <target name='integration-test-dtls' depends='integration-setup'
          description='Run DTLS (UDP) integration tests'>
    <integration-junit includes='**/dtls/*IntegrationTest.java'/>
  </target>

  <!-- Run AMQP client tests against a real, locally-running RabbitMQ
       broker (plaintext + TLS + management API on their usual ports).
       Deliberately NOT a dependency of 'integration-test' below: unlike
       every other integration-test-* target, this needs an external
       service that will never exist in CI. Each test class also probes
       broker reachability itself and self-skips (via Assume) if it's
       not there, as a second line of defense; the real point of keeping
       this out of the aggregate is that a developer running
       'ant integration-test' shouldn't need RabbitMQ running locally
       just to get a clean run. See RabbitMQTestSupport's class Javadoc
       for how to start a matching broker. -->
  <target name='integration-test-amqp-rabbitmq' depends='integration-build'
          description='Run AMQP client tests against a local real RabbitMQ broker (not part of integration-test)'>
    <integration-junit includes='**/amqp/rabbitmq/*IntegrationTest.java'/>
  </target>

  <!-- Run SMTP client tests against a real, locally-running Postfix
       instance: same rationale as integration-test-amqp-rabbitmq
       above (a wire-compatible but independent implementation catches
       bugs a same-lineage fake server can't), and likewise deliberately
       NOT a dependency of 'integration-test'. See PostfixTestSupport's
       class Javadoc for how to build and start a matching container. -->
  <target name='integration-test-smtp-postfix' depends='integration-build'
          description='Run SMTP client tests against a local real Postfix instance (not part of integration-test)'>
    <integration-junit includes='**/smtp/postfix/*IntegrationTest.java'/>
  </target>

  <!-- Run FTP client tests against a real, locally-running vsftpd
       instance: same rationale as the two targets above, and likewise
       deliberately NOT a dependency of 'integration-test'. Also the
       only place AUTH TLS/PROT P is exercised against a real TLS
       handshake and encrypted data channel: FTPClientIntegrationTest's
       server config is plaintext-only. See VsftpdTestSupport's class
       Javadoc for how to build and start a matching container. -->
  <target name='integration-test-ftp-vsftpd' depends='integration-build'
          description='Run FTP client tests against a local real vsftpd instance (not part of integration-test)'>
    <integration-junit includes='**/ftp/vsftpd/*IntegrationTest.java'/>
  </target>

  <!-- Run SOCKS client tests against a real, locally-running Dante
       (danted) SOCKS5 proxy, tunnelling to the same Postfix container
       the smtp-postfix target uses: same rationale as the targets
       above, and likewise deliberately NOT a dependency of
       'integration-test'. See DantedTestSupport's class Javadoc for how
       to build and start the matching containers (proxy + Postfix, on
       a shared podman network). -->
  <target name='integration-test-socks-danted' depends='integration-build'
          description='Run SOCKS client tests against a local real Dante proxy (not part of integration-test)'>
    <integration-junit includes='**/socks/danted/*IntegrationTest.java'/>
  </target>

  <!-- Run LDAP client tests against a real, locally-running OpenLDAP
       (slapd) instance: same rationale as the targets above, and
       likewise deliberately NOT a dependency of 'integration-test'.
       See OpenLdapTestSupport's class Javadoc for how to build and
       start the matching container. -->
  <target name='integration-test-ldap-openldap' depends='integration-build'
          description='Run LDAP client tests against a local real OpenLDAP instance (not part of integration-test)'>
    <integration-junit includes='**/ldap/openldap/*IntegrationTest.java'/>
  </target>

  <!-- Run Redis client tests against a real, locally-running Redis
       instance: same rationale as the targets above, and likewise
       deliberately NOT a dependency of 'integration-test'. See
       RedisTestSupport's class Javadoc for how to build and start the
       matching container. -->
  <target name='integration-test-redis-redis' depends='integration-build'
          description='Run Redis client tests against a local real Redis instance (not part of integration-test)'>
    <integration-junit includes='**/redis/redis/*IntegrationTest.java'/>
  </target>

  <!-- Run MQTT client tests against a real, locally-running Eclipse
       Mosquitto instance: same rationale as the targets above, and
       likewise deliberately NOT a dependency of 'integration-test'.
       See MosquittoTestSupport's class Javadoc for how to build and
       start the matching container. -->
  <target name='integration-test-mqtt-mosquitto' depends='integration-build'
          description='Run MQTT client tests against a local real Mosquitto instance (not part of integration-test)'>
    <integration-junit includes='**/mqtt/mosquitto/*IntegrationTest.java'/>
  </target>

  <!-- Run gRPC client tests against a real, locally-running Python
       (grpcio) gRPC server implementing a small custom Echo service:
       same rationale as the targets above, and likewise deliberately
       NOT a dependency of 'integration-test'. See PyGrpcTestSupport's
       class Javadoc for how to build and start the matching container,
       and for why a custom server was needed here specifically. -->
  <target name='integration-test-grpc-pygrpc' depends='integration-build'
          description='Run gRPC client tests against a local real Python gRPC server (not part of integration-test)'>
    <integration-junit includes='**/grpc/pygrpc/*IntegrationTest.java'/>
  </target>

  <!-- Run DNS client tests against a real, locally-running AdGuard
       Home instance, covering every transport the client supports
       (plain UDP/TCP, DoT, DoH, DoQ): same rationale as the targets
       above, and likewise deliberately NOT a dependency of
       'integration-test'. See AdGuardTestSupport's class Javadoc for
       how to build and start the matching container. -->
  <target name='integration-test-dns-adguard' depends='integration-build'
          description='Run DNS client tests against a local real AdGuard Home instance (not part of integration-test)'>
    <integration-junit includes='**/dns/adguard/*IntegrationTest.java'/>
  </target>

  <!-- Generate HTML test reports from XML results -->
  <target name='integration-report'
          description='Generate HTML report from integration test results'>
    <mkdir dir='${test}/integration/results/html'/>
    <junitreport todir='${test}/integration/results/reports'>
      <fileset dir='${test}/integration/results/xml'>
        <include name='TEST-*.xml'/>
      </fileset>
      <report format='frames' todir='${test}/integration/results/html'/>
    </junitreport>
    <echo message='HTML report generated at: ${test}/integration/results/html/index.html'/>
  </target>

  <!-- Run all integration tests -->
  <target name='integration-test'
          depends='integration-test-http,integration-test-http-client,integration-test-smtp,integration-test-pop3,integration-test-imap,integration-test-ftp,integration-test-servlet,integration-test-telemetry,integration-test-buffer,integration-test-tls,integration-test-websocket,integration-test-dtls'
          description='Run all integration tests'>
  </target>

  <!-- Run all integration tests with reports -->
  <target name='integration-test-full' 
          depends='integration-setup,integration-test,integration-report'
          description='Run all integration tests with setup and reporting'>
  </target>

  <!-- Run all tests -->
  <target name='test-all' depends='junit-test,integration-test' 
          description='Run all unit and integration tests'>
  </target>

  <!-- Clean integration test results -->
  <target name='integration-clean'
          description='Clean integration test results'>
    <delete dir='${test}/integration/classes'/>
    <delete dir='${test}/integration/results'/>
    <delete dir='${test}/integration/webapp/WEB-INF/classes'/>
  </target>

</project>
